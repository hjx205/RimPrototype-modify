<?xml version="1.0" encoding="UTF-8"?>
<Defs>
    <HediffDef>
        <defName>BlackLightcoma</defName>
        <label>blacklight coma</label>
        <description>This coma occurs when the Blacklight Gene selects and screens characters. Failure to pass this screening triggers the coma. The coma typically lasts for three days, and on the third day after the character awakens, the gene will conduct another selection.</description>
        <hediffClass>HediffWithComps</hediffClass>
        <initialSeverity>0.001</initialSeverity>
        <defaultLabelColor>(0.9, 1.0, 0.35)</defaultLabelColor>
        <forceRemoveOnResurrection>true</forceRemoveOnResurrection>
        <stages>
            <li>
                <capMods>
                    <li>
                        <capacity>Consciousness</capacity>
                        <setMax>0.1</setMax>
                    </li>
                </capMods>
            </li>
        </stages>
        <comps>
            <li Class="HediffCompProperties_Disappears">
                <compClass>HediffComp_DisappearsPausable_LethalInjuries</compClass>
                <disappearsAfterTicks>180000</disappearsAfterTicks>
                <showRemainingTime>true</showRemainingTime>
            </li>
        </comps>
    </HediffDef>

    <HediffDef>
        <defName>Hediff_ParenchymaCore</defName>
        <countsAsAddedPartOrImplant>false</countsAsAddedPartOrImplant>
        <label>Parenchyma Core</label>
        <description>The parenchyma core is the standard organ of the evolver. Though inferior to the protoplasm's biomass nucleus, it still grants the evolver extraordinary regenerative abilities and enhances their physical capabilities.</description>
        <isBad>false</isBad>
        <preventsDeath>false</preventsDeath>
        <keepOnBodyPartRestoration>True</keepOnBodyPartRestoration>
        <defaultLabelColor>(0.9, 0.1, 0.1)</defaultLabelColor>
        <initialSeverity>0.001</initialSeverity>
        <stages>
            <li>
                <regeneration>30</regeneration>
                <showRegenerationStat>true</showRegenerationStat>
                <statFactors>
                    <MoveSpeed>1.3</MoveSpeed>
                </statFactors>
                <statOffsets>
                    <ArmorRating_Sharp>0.15</ArmorRating_Sharp>
                    <ArmorRating_Blunt>0.15</ArmorRating_Blunt>
                    <ArmorRating_Heat>0.15</ArmorRating_Heat>
                    <PainShockThreshold>0.1</PainShockThreshold>
                </statOffsets>
                <capMods>
                    <li>
                        <capacity>Consciousness</capacity>
                        <offset>0.25</offset>
                    </li>
                    <li>
                        <capacity>BloodFiltration</capacity>
                        <offset>0.15</offset>
                    </li>
                    <li>
                        <capacity>BloodPumping</capacity>
                        <offset>0.15</offset>
                    </li>
                    <li>
                        <capacity>Breathing</capacity>
                        <offset>0.15</offset>
                    </li>
                    <li>
                        <capacity>Eating</capacity>
                        <offset>0.15</offset>
                    </li>
                    <li>
                        <capacity>Hearing</capacity>
                        <offset>0.15</offset>
                    </li>
                    <li>
                        <capacity>Manipulation</capacity>
                        <offset>0.15</offset>
                    </li>
                    <li>
                        <capacity>Metabolism</capacity>
                        <offset>0.15</offset>
                    </li>
                    <li>
                        <capacity>Moving</capacity>
                        <offset>0.15</offset>
                    </li>
                    <li>
                        <capacity>Sight</capacity>
                        <offset>0.15</offset>
                    </li>
                    <li>
                        <capacity>Talking</capacity>
                        <offset>0.15</offset>
                    </li>
                </capMods>
            </li>
        </stages>
        <abilities>
            <li>BMN_Evolution_inferior</li>
        </abilities>
    </HediffDef>
</Defs>