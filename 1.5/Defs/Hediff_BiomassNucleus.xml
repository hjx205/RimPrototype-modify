    <HediffDef ParentName="AddedMutationBase">
        <defName>Hediff_bladeform</defName>
        <label>Bladeform</label>
        <labelNoun>a blade</labelNoun>
        <description>A blade formed by the aggregation of biomass, possessing extreme destructive power and mobility. Its attack speed, attack power, and penetration grow with the increase in integration count.</description>
        <keepOnBodyPartRestoration>false</keepOnBodyPartRestoration>
        <descriptionHyperlinks><ThingDef>BMN_Bladeform</ThingDef></descriptionHyperlinks>
        <defaultInstallPart>Shoulder</defaultInstallPart>
        <hediffClass>Hjx_BiomassNucleus.Hediff_BiomassPartBlade</hediffClass>
        <stages>
            <li>
                <statOffsets>
                    <PawnBeauty>-1</PawnBeauty>
                </statOffsets>
            </li>
        </stages>
        <addedPartProps>
            <solid>true</solid>
            <partEfficiency>1.50</partEfficiency>
        </addedPartProps>
        <comps>
            <li Class="HediffCompProperties_VerbGiver">
                <tools>
                    <li>
                        <label>blade</label>
                        <capacities>
                            <li>Cut</li>
                        </capacities>
                        <power>28</power>
                        <armorPenetration>0.68</armorPenetration>
                        <cooldownTime>2</cooldownTime>
                        <alwaysTreatAsWeapon>true</alwaysTreatAsWeapon>
                        <soundMeleeHit>Pawn_Ghoul_Scratch</soundMeleeHit>
                        <soundMeleeMiss>Pawn_Melee_SmallScratch_Miss</soundMeleeMiss>
                    </li>
                </tools>
            </li>
        </comps>
        <renderNodeProperties>
            <li Class="Hjx_BiomassNucleus.PawnRenderNodeProperties_Spastic">
                <texPaths>
                    <li>Hjx_BiomassNucleus/bladeform</li>
                </texPaths>
                <parentTagDef>Body</parentTagDef>
                <overrideMeshSize>1</overrideMeshSize>
                <drawSize>1.3</drawSize>
                <rotationRange>-5~5</rotationRange>
                <durationTicksRange>60~60</durationTicksRange>
                <nextSpasmTicksRange>100~150</nextSpasmTicksRange>
                <drawData>
                    <scaleOffsetByBodySize>false</scaleOffsetByBodySize>
                    <useHediffAnchor>false</useHediffAnchor>
                    <childScale>1</childScale>
                    <defaultData>
                        <layer>90</layer>
                    </defaultData>
                    <dataNorth>
                        <rotationOffset>0</rotationOffset>
                        <flip>true</flip>
                        <layer>0</layer>
                    </dataNorth>
                    <dataEast>
                        <rotationOffset>270</rotationOffset>
                        <flip>false</flip>
                    </dataEast>
                    <dataSouth>
                        <rotationOffset>180</rotationOffset>
                        <offset>(-0.1, 0, 0)</offset>
                    </dataSouth>
                    <dataWest>
                        <rotationOffset>90</rotationOffset>
                        <flip>true</flip>
                        <layer>0</layer>
                    </dataWest>
                </drawData>
            </li>
        </renderNodeProperties>
    </HediffDef>

