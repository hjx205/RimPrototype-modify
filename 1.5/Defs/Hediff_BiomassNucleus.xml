<?xml version="1.0" encoding="UTF-8"?>
<Defs>
    <HediffDef>
        <defName>Hediff_BiomassNucleus</defName>
        <label>Biomass nucleus</label>
        <hediffClass>Hjx_BiomassNucleus.Hediff_BiomassNucleus</hediffClass>
        <description>This nucleus is fully integrated into the ‌host's‌ body, making it indistinguishable from the ‌host‌ at the cellular level.</description>
        <isBad>false</isBad>
        <preventsDeath>false</preventsDeath>
        <keepOnBodyPartRestoration>True</keepOnBodyPartRestoration>
        <defaultLabelColor>(0.9, 0.1, 0.1)</defaultLabelColor>
        <initialSeverity>0</initialSeverity>
        <stages>
            <li>
                <label>Lv.1</label>
                <minSeverity>0</minSeverity>
                <regeneration>20</regeneration>
                <showRegenerationStat>true</showRegenerationStat>
                <statFactors>
                    <MoveSpeed>1.2</MoveSpeed>
                </statFactors>
                <statOffsets>
                    <PainShockThreshold>0.2</PainShockThreshold>
                </statOffsets>
            </li>
            <li>
                <label>Lv.2</label>
                <minSeverity>0.1</minSeverity>
                <regeneration>30</regeneration>
                <showRegenerationStat>true</showRegenerationStat>
                <statFactors>
                    <MoveSpeed>1.25</MoveSpeed>
                </statFactors>
                <statOffsets>
                    <PainShockThreshold>0.2</PainShockThreshold>
                </statOffsets>
            </li>
            <li>
                <label>Lv.3</label>
                <minSeverity>0.2</minSeverity>
                <regeneration>40</regeneration>
                <showRegenerationStat>true</showRegenerationStat>
                <statFactors>
                    <MoveSpeed>1.3</MoveSpeed>
                </statFactors>
                <statOffsets>
                    <PainShockThreshold>0.2</PainShockThreshold>
                </statOffsets>
            </li>
            <li>
                <label>Lv.4</label>
                <minSeverity>0.3</minSeverity>
                <regeneration>50</regeneration>
                <showRegenerationStat>true</showRegenerationStat>
                <statFactors>
                    <MoveSpeed>1.35</MoveSpeed>
                </statFactors>
                <statOffsets>
                    <PainShockThreshold>0.2</PainShockThreshold>
                </statOffsets>
            </li>
            <li>
                <label>Lv.5</label>
                <minSeverity>0.4</minSeverity>
                <regeneration>60</regeneration>
                <showRegenerationStat>true</showRegenerationStat>
                <statFactors>
                    <MoveSpeed>1.4</MoveSpeed>
                </statFactors>
                <statOffsets>
                    <PainShockThreshold>0.2</PainShockThreshold>
                </statOffsets>
            </li>
            <li>
                <label>Lv.6</label>
                <minSeverity>0.5</minSeverity>
                <regeneration>70</regeneration>
                <showRegenerationStat>true</showRegenerationStat>
                <statFactors>
                    <MoveSpeed>1.45</MoveSpeed>
                </statFactors>
                <statOffsets>
                    <PainShockThreshold>0.2</PainShockThreshold>
                </statOffsets>
            </li>
            <li>
                <label>Lv.7</label>
                <minSeverity>0.6</minSeverity>
                <regeneration>80</regeneration>
                <showRegenerationStat>true</showRegenerationStat>
                <statFactors>
                    <MoveSpeed>1.5</MoveSpeed>
                </statFactors>
                <statOffsets>
                    <PainShockThreshold>0.2</PainShockThreshold>
                </statOffsets>
            </li>
            <li>
                <label>Lv.8</label>
                <minSeverity>0.7</minSeverity>
                <regeneration>90</regeneration>
                <showRegenerationStat>true</showRegenerationStat>
                <statFactors>
                    <MoveSpeed>1.55</MoveSpeed>
                </statFactors>
                <statOffsets>
                    <PainShockThreshold>0.2</PainShockThreshold>
                </statOffsets>
            </li>
            <li>
                <label>Lv.9</label>
                <minSeverity>0.8</minSeverity>
                <regeneration>100</regeneration>
                <showRegenerationStat>true</showRegenerationStat>
                <statFactors>
                    <MoveSpeed>1.6</MoveSpeed>
                </statFactors>
                <statOffsets>
                    <PainShockThreshold>0.2</PainShockThreshold>
                </statOffsets>
            </li>
        </stages>
        <abilities>
            <li>BMN_Integrate</li>
            <li>BMN_BiomassNode</li>
            <li>BMN_AirDash</li>
        </abilities>
    </HediffDef>

    <!-- 怪异心脏 -->
    <ThingDef ParentName="ArtifactBase">
        <defName>BMN_BiomassNucleus</defName>
        <label>Anomaly heart</label>
        <description>A heart formed by a mass of black, liquid metal-like substance.It is beating slowly, even when detached from external circulatory support.</description>
        <tradeability>None</tradeability>
        <graphicData>
            <texPath>Hjx_BiomassNucleus/BiomassNucleus</texPath>
            <graphicClass>Graphic_Single</graphicClass>
            <drawSize>0.7</drawSize>
        </graphicData>
        <stealable>false</stealable>
        <resourceReadoutPriority>Middle</resourceReadoutPriority>
        <stackLimit>1</stackLimit>
        <tradeNeverStack>true</tradeNeverStack>
        <relicChance>0</relicChance>
        <useHitPoints>false</useHitPoints>
        <statBases>
            <MarketValue>1700</MarketValue>
        </statBases>
        <drawGUIOverlay>false</drawGUIOverlay>
        <thingSetMakerTags IsNull="true"/>
        <comps>
            <li Class="Hjx_BiomassNucleus.CompProperties_UseBiomassNucleus">
                <hediffDef>Hediff_BiomassNucleus</hediffDef>
                <letterDef>PositiveEvent</letterDef>
            </li>
        </comps>
    </ThingDef>

    <HediffDef ParentName="AddedMutationBase"> <!-- 利爪R -->
        <defName>Hediff_clawformR</defName>
        <label>Clawform</label>
        <labelNoun>a claw</labelNoun>
        <hediffClass>Hjx_BiomassNucleus.Hediff_BiomassPartClaw</hediffClass>
        <description>A claw formed by the aggregation of biomass. Its attack speed and penetration grow with the increase in integration count.</description>
        <keepOnBodyPartRestoration>false</keepOnBodyPartRestoration>
        <descriptionHyperlinks><ThingDef>BMN_ClawformR</ThingDef></descriptionHyperlinks>
        <defaultInstallPart>Shoulder</defaultInstallPart>
        <stages>
            <li>
                <statOffsets>
                    <PawnBeauty>-1</PawnBeauty>
                </statOffsets>
            </li>
        </stages>
        <addedPartProps>
            <solid>true</solid>
            <partEfficiency>1.50</partEfficiency>
        </addedPartProps>
        <comps>
            <li Class="HediffCompProperties_VerbGiver">
                <tools>
                    <li>
                        <label>claw</label>
                        <capacities>
                            <li>Cut</li>
                        </capacities>
                        <power>12</power>
                        <armorPenetration>0.38</armorPenetration>
                        <cooldownTime>1.6</cooldownTime>
                        <alwaysTreatAsWeapon>true</alwaysTreatAsWeapon>
                        <soundMeleeHit>Pawn_Melee_PowerClaw_Hit</soundMeleeHit>
                        <soundMeleeMiss>Pawn_Melee_PowerClaw_Miss</soundMeleeMiss>
                    </li>
                </tools>
            </li>
        </comps>
        <renderNodeProperties>
            <li Class="Hjx_BiomassNucleus.PawnRenderNodeProperties_Spastic">
                <texPaths>
                    <li>Hjx_BiomassNucleus/clawform</li>
                </texPaths>
                <parentTagDef>Body</parentTagDef>
                <overrideMeshSize>1</overrideMeshSize>
                <drawSize>1.2</drawSize>
                <drawData>
                    <scaleOffsetByBodySize>false</scaleOffsetByBodySize>
                    <useHediffAnchor>false</useHediffAnchor>
                    <childScale>1</childScale>
                    <bodyTypeScales>
                        <Hulk>1.2</Hulk>
                        <Fat>1.4</Fat>
                        <Thin>1</Thin>
                    </bodyTypeScales>
                    <defaultData>
                        <layer>88</layer>
                    </defaultData>
                    <dataNorth>
                        <rotationOffset>0</rotationOffset>
                        <flip>true</flip>
                        <layer>0</layer>
                    </dataNorth>
                    <dataEast>
                        <rotationOffset>230</rotationOffset>
                        <flip>false</flip>
                        <offset>(0, 0, 0)</offset>
                    </dataEast>
                    <dataSouth>
                        <rotationOffset>180</rotationOffset>
                    </dataSouth>
                    <dataWest>
                        <rotationOffset>130</rotationOffset>
                        <flip>true</flip>
                        <layer>0</layer>
                        <offset>(0, 0, 0)</offset>
                    </dataWest>
                </drawData>
            </li>
        </renderNodeProperties>
    </HediffDef>

    <ThingDef ParentName="BodyPartArchotechBase">
        <defName>BMN_ClawformR</defName>
        <label>Clawform</label>
        <description>----</description>
        <thingSetMakerTags IsNull="true"/>
        <statBases>
            <MarketValue>2800</MarketValue>
