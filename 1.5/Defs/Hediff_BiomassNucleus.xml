    <!-- 手术配方 -->
    <RecipeDef ParentName="SurgeryInstallBodyPartArtificialBase">
        <defName>InstallClawformR</defName>
        <label>install claw</label>
        <description>Install a claw</description>
        <descriptionHyperlinks>
            <ThingDef>BMN_ClawformR</ThingDef>
            <HediffDef>Hediff_clawformR</HediffDef>
        </descriptionHyperlinks>
        <jobString>Installing Clawform.</jobString>
        <ingredients>
            <li>
                <filter>
                    <thingDefs>
                        <li>BMN_ClawformR</li>
                    </thingDefs>
                </filter>
                <count>1</count>
            </li>
        </ingredients>
        <fixedIngredientFilter>
            <thingDefs>
                <li>BMN_ClawformR</li>
            </thingDefs>
        </fixedIngredientFilter>
        <appliedOnFixedBodyParts>
            <li>Shoulder</li>
        </appliedOnFixedBodyParts>
        <addsHediff>Hediff_clawformR</addsHediff>
    </RecipeDef>

