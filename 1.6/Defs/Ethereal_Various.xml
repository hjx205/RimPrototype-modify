<?xml version="1.0" encoding="UTF-8"?>
<Defs>
    <!-- 飞行物实体定义 -->
    <ThingDef Name="PawnFlyer_BladeSprint" ParentName="EtherealThingBase">
        <defName>PawnFlyer_BladeSprint</defName>
        <label>flying</label>
        <thingClass>PawnFlyer</thingClass>
        <useHitPoints>false</useHitPoints>
        <drawOffscreen>true</drawOffscreen>
        <tickerType>Normal</tickerType>
        <altitudeLayer>Skyfaller</altitudeLayer>
        <drawerType>RealtimeOnly</drawerType>
        <pawnFlyer>
            <flightDurationMin>0.1</flightDurationMin>
            <flightSpeed>128</flightSpeed>
            <workerClass>PawnFlyerWorker</workerClass>
            <heightFactor>0</heightFactor> <!-- 贴地 -->
            <progressCurve>
                <points>
                    <!-- 起点 -->
                    <li>(0, 0)</li>
                    <!-- 加速段 -->
                    <li>(0.4, 0.9)</li>
                    <!-- 终点 -->
                    <li>(1, 1)</li>
                </points>
            </progressCurve>
        </pawnFlyer>
    </ThingDef>

    <ThingDef Name="PawnFlyer_BMN_Longjump" ParentName="EtherealThingBase">
        <defName>PawnFlyer_BMN_Longjump</defName>
        <label>flying</label>
        <thingClass>PawnFlyer</thingClass>
        <useHitPoints>false</useHitPoints>
        <drawOffscreen>true</drawOffscreen>
        <tickerType>Normal</tickerType>
        <altitudeLayer>Skyfaller</altitudeLayer>
        <drawerType>RealtimeOnly</drawerType>
        <pawnFlyer>
            <flightDurationMin>0.5</flightDurationMin>
            <flightSpeed>24</flightSpeed>
            <workerClass>PawnFlyerWorker</workerClass>
            <heightFactor>0.5</heightFactor>
            <progressCurve>
                <points>
                    <li>(0, 0)</li>
                    <li>(0.1, 0.15)</li>
                    <li>(1, 1)</li>
                </points>
            </progressCurve>
        </pawnFlyer>
    </ThingDef>
</Defs>